    "tiltFrame": "euler_attitude",
    "absoluteWorld": false,
    "panDeg": [-140.0, 140.0],
    "tiltDeg": [-110.0, 120.0],
    "maxControlSpeedDegS": 150.0,
    "recommendedCommandHz": [30, 50],
    "stabilizationAccuracyDeg": 0.01,
    "repeatabilityDeg": null,
    "settleTimeS": null
  },
  "stillCapture": {
    "supported": true,
    "mode": "platform_frame_from_live_video",
    "usesExistingInteractionVideo": true,
