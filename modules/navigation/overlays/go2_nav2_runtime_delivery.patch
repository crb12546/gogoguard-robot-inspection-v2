+
+    # The commissioned Go2 does not make useful forward progress below
+    # 0.20 m/s.  Keep MPPI inside that effective gait for normal patrol, and
+    # use a separate standard Nav2 controller for the bounded A* detour. RPP
+    # can emit vx=0 while it rotates to the detour heading. SlowZone is the
+    # downstream owner of obstacle slowdown and multiplies this command by
+    # 0.85, so request 0.24 m/s here to preserve an effective 0.204 m/s gait
+    # after slowdown instead of falling back into the commissioned deadband.
+    DetourPath:
+      plugin: nav2_regulated_pure_pursuit_controller::RegulatedPurePursuitController
+      desired_linear_vel: 0.24
+      lookahead_dist: 0.35
+      min_lookahead_dist: 0.25
+      max_lookahead_dist: 0.50
+      lookahead_time: 1.0
+      rotate_to_heading_angular_vel: 0.40
+      transform_tolerance: 0.20
+      use_velocity_scaled_lookahead_dist: false
+      min_approach_linear_velocity: 0.24
+      approach_velocity_scaling_dist: 0.30
+      use_collision_detection: true
+      max_allowed_time_to_collision_up_to_carrot: 0.70
+      use_regulated_linear_velocity_scaling: true
+      use_cost_regulated_linear_velocity_scaling: false
+      regulated_linear_scaling_min_radius: 0.70
+      regulated_linear_scaling_min_speed: 0.24
+      use_rotate_to_heading: true
+      rotate_to_heading_min_angle: 0.35
+      max_angular_accel: 0.80
+      allow_reversing: false
+      use_interpolation: true
