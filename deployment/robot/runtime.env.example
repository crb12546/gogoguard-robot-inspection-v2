ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
GOGOGUARD_MAP_WORKER=none
GOGOGUARD_ROBOT_ID=LLYJ0001
GOGOGUARD_INTERACTION_ENABLED=0
GOGOGUARD_INTERACTION_ALLOW_INSECURE_WS=0
GOGOGUARD_INTERACTION_CA_FILE=
GOGOGUARD_PLATFORM_HEARTBEAT_ENABLED=0
GOGOGUARD_PLATFORM_HEARTBEAT_URL=https://gogoguard.cn/api/v1/robot/heartbeat
GOGOGUARD_PLATFORM_HEARTBEAT_INTERVAL_S=5
GOGOGUARD_PLATFORM_HEARTBEAT_TLS_INSECURE=0
GOGOGUARD_PLATFORM_HEARTBEAT_CA_FILE=
GOGOGUARD_PLATFORM_HEARTBEAT_HOST_HEADER=
GOGOGUARD_PLATFORM_HEARTBEAT_ALLOW_HTTP=0
# Bilateral evidence transaction v1. Keep off until the platform advertises
# the pinned manifest and the zero-motion dual-end replay has passed.
GOGOGUARD_CHECKPOINT_EVIDENCE_TXN_ENABLED=0
# Platform-issued per-device bearer token. It may be empty only while platform
# heartbeat is disabled. Commission it once in the robot-local root-only file;
# release archives and images must never contain the value.
GOGOGUARD_DEVICE_TOKEN=
# Provision only on the commissioned robot in /etc/gogoguard/runtime.env.
# Never commit the per-device value or copy it into a release archive.
UNITREE_AES_128_KEY=
