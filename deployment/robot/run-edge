#!/usr/bin/env bash
set -euo pipefail
source /etc/gogoguard/release.env
exec docker run --rm --name gogoguard-edge \
  --stop-timeout 15 \
  --network host \
  --ipc host \
  --privileged \
  --env-file /etc/gogoguard/runtime.env \
  --env-file /etc/gogoguard/release.env \
  -v /var/lib/gogoguard:/var/lib/gogoguard \
  -v /etc/gogoguard/runtime.json:/etc/gogoguard/runtime.json:ro \
  "${GOGOGUARD_IMAGE}"
