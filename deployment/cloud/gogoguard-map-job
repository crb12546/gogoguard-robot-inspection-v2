#!/usr/bin/env bash
set -euo pipefail
umask 027

readonly JOB_ROOT=${1:-}
readonly PIPELINE_ROOT=/opt/go2/gogoguard_dog_go2_real_code
readonly PIPELINE_ENTRY="$PIPELINE_ROOT/deploy/cloud_mapping_worker/run_pipeline.sh"
readonly GLIM_CONFIG=/opt/go2/glim/jazzy-config
readonly MAPPING_PYTHON=/opt/go2/mapping-python-jazzy/bin/python

if [[ ${EUID} -ne 0 ]]; then
  echo "gogoguard-map-job must run as root" >&2
  exit 77
fi
if [[ ! $JOB_ROOT =~ ^/opt/go2/jobs/map-[A-Za-z0-9]{12}$ ]]; then
  echo "invalid V2 map job path: $JOB_ROOT" >&2
  exit 78
fi
if [[ ! -d $JOB_ROOT || -L $JOB_ROOT ]]; then
  echo "map job directory is missing or unsafe" >&2
  exit 78
fi

readonly JOB_ID=${JOB_ROOT##*/}
readonly BUILD_ID="${JOB_ID}-review"
readonly INPUT_ROOT="$JOB_ROOT/input"
readonly BAG_ROOT="$INPUT_ROOT/raw/rosbag"
readonly WORK_ROOT="$JOB_ROOT/work"
readonly BUILD_ROOT="$WORK_ROOT/builds/$BUILD_ID"
readonly REVIEW_ARTIFACTS="$BUILD_ROOT/artifacts"
readonly OUTPUT_ROOT="$JOB_ROOT/output"
readonly OUTPUT_STAGING="$JOB_ROOT/.output-staging"

for required in \
  "$PIPELINE_ENTRY" \
  "$GLIM_CONFIG/config.json" \
  "$BAG_ROOT/metadata.yaml" \
  "$INPUT_ROOT/session.json"; do
  if [[ ! -e $required || -L $required ]]; then
    echo "cloud map input is missing or unsafe: $required" >&2
    exit 78
  fi
done
if [[ ! -x $MAPPING_PYTHON ]]; then
  echo "sealed mapping Python executable is missing" >&2
  exit 78
fi
if [[ -e $WORK_ROOT || -e $OUTPUT_ROOT || -e $OUTPUT_STAGING ]]; then
  echo "map job output already exists; job ids are immutable" >&2
  exit 78
fi

readonly SITE_ID=$(python3 -c \
  'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["site_id"])' \
  "$INPUT_ROOT/session.json")

chown -R go2mapping:go2mapping "$JOB_ROOT"

run_pipeline() {
  /usr/sbin/runuser -u go2mapping -- "$PIPELINE_ENTRY" "$@"
}

progress() {
  local percent=$1
  local stage=$2
  shift 2
  echo "GOGOGUARD_PROGRESS $percent $stage $*"
}

progress 72 cloud_validation "云端校验录制包与 GLIM 配置"
run_pipeline prepare-session \
  --root "$WORK_ROOT" \
  --glim-config "$GLIM_CONFIG" \
  --session-id "$JOB_ID" \
  --site-id "$SITE_ID" \
  --operator gogoguard-v2 \
  --bag "$BAG_ROOT" \
  --compute-profile cpu

progress 76 glim_optimization "GLIM 轨迹优化与子图构建"
run_pipeline run-session \
  --root "$WORK_ROOT" \
  --glim-config "$GLIM_CONFIG" \
  --session-id "$JOB_ID"

progress 86 map_build "组合 GLIM 会话与版本化地图"
run_pipeline create-build \
  --root "$WORK_ROOT" \
  --glim-config "$GLIM_CONFIG" \
  --build-id "$BUILD_ID" \
  --site-id "$SITE_ID" \
  --session-id "$JOB_ID"

progress 90 review_artifacts "生成点云与地图评审产物"
run_pipeline produce-review-artifacts \
  --root "$WORK_ROOT" \
  --glim-config "$GLIM_CONFIG" \
  --build-id "$BUILD_ID"

progress 92 artifact_export "导出 PLY、轨迹、2D 概览和建图回执"
install -d -o go2mapping -g go2mapping -m 0750 "$OUTPUT_STAGING"
/usr/sbin/runuser -u go2mapping -- "$MAPPING_PYTHON" - \
  "$REVIEW_ARTIFACTS/map.ply" \
  "$WORK_ROOT/sessions/$JOB_ID/dump/traj_lidar.txt" \
  "$BUILD_ROOT/build.json" \
  "$OUTPUT_STAGING" <<'PY'
import html
import json
import math
import shutil
import sys
from pathlib import Path

import numpy as np
import open3d as o3d

ply_path, trajectory_path, build_path, output_root = map(Path, sys.argv[1:])
cloud = o3d.io.read_point_cloud(str(ply_path))
points_array = np.asarray(cloud.points)
if points_array.ndim != 2 or points_array.shape[1] != 3 or not len(points_array):
    raise SystemExit("GLIM export contains no XYZ points")
points_array = points_array[np.isfinite(points_array).all(axis=1)]
if len(points_array) > 50000:
    indices = np.linspace(0, len(points_array) - 1, 50000, dtype=np.int64)
    points_array = points_array[indices]
points = [[float(x), float(y), float(z), 0.7] for x, y, z in points_array]

trajectory = []
optimized_poses = []
previous_timestamp = -math.inf
for raw in trajectory_path.read_text(encoding="utf-8").splitlines():
    values = raw.split()
    if not values:
        continue
    if len(values) != 8:
        raise SystemExit("GLIM trajectory contains a malformed pose")
    timestamp, x, y, z, qx, qy, qz, qw = (float(value) for value in values)
    if not all(
        math.isfinite(value)
        for value in (timestamp, x, y, z, qx, qy, qz, qw)
    ):
        raise SystemExit("GLIM trajectory contains a non-finite pose")
    if timestamp <= previous_timestamp:
        raise SystemExit("GLIM trajectory timestamps are not strictly increasing")
    if math.sqrt(qx * qx + qy * qy + qz * qz + qw * qw) < 0.5:
        raise SystemExit("GLIM trajectory contains an invalid quaternion")
    trajectory.append([x, y, z])
    optimized_poses.append(
        {
            "timestamp": timestamp,
            "x": x,
            "y": y,
            "z": z,
            "qx": qx,
            "qy": qy,
            "qz": qz,
            "qw": qw,
        }
    )
    previous_timestamp = timestamp
if len(trajectory) < 2:
    raise SystemExit("GLIM trajectory contains fewer than two poses")

build = json.loads(build_path.read_text(encoding="utf-8"))
artifact = {
    "schema": "gogoguard.map_artifact.v1",
    "source": "cloud-glim",
    "build_id": build["buildId"],
    "build_state": build["state"],
    "trajectory": trajectory,
    "points": points,
}
(output_root / "map.json").write_text(
    json.dumps(
        artifact,
        ensure_ascii=False,
        separators=(",", ":"),
        allow_nan=False,
    )
    + "\n",
    encoding="utf-8",
)
(output_root / "trajectory-poses.json").write_text(
    json.dumps(
        {
            "schema": "gogoguard.optimized_trajectory.v1",
            "frame": "map",
            "poses": optimized_poses,
        },
        ensure_ascii=False,
        separators=(",", ":"),
        allow_nan=False,
    )
    + "\n",
    encoding="utf-8",
)
shutil.copy2(ply_path, output_root / "map.ply")
shutil.copy2(build_path, output_root / "glim-build.json")

overview_points = points[:: max(1, len(points) // 2500)]
xs = [p[0] for p in overview_points] + [p[0] for p in trajectory]
ys = [p[1] for p in overview_points] + [p[1] for p in trajectory]
min_x, max_x, min_y, max_y = min(xs), max(xs), min(ys), max(ys)
scale = min(700 / max(max_x - min_x, 0.1), 440 / max(max_y - min_y, 0.1))

def xy(point):
    return 50 + (point[0] - min_x) * scale, 490 - (point[1] - min_y) * scale

dots = "".join(
    f'<circle cx="{xy(p)[0]:.1f}" cy="{xy(p)[1]:.1f}" r="1.1" fill="#64748b" opacity=".55"/>'
    for p in overview_points
)
route = " ".join(f"{xy(p)[0]:.1f},{xy(p)[1]:.1f}" for p in trajectory)
label = html.escape(f"GLIM candidate · {len(points)} displayed points")
svg = (
    '<svg xmlns="http://www.w3.org/2000/svg" width="800" height="540" viewBox="0 0 800 540">'
    '<rect width="800" height="540" fill="#07111f"/>'
    f'<text x="28" y="34" fill="#dbeafe" font-family="sans-serif" font-size="18">{label}</text>'
    f'{dots}<polyline points="{route}" fill="none" stroke="#22d3ee" stroke-width="4"/>'
    f'<circle cx="{xy(trajectory[-1])[0]:.1f}" cy="{xy(trajectory[-1])[1]:.1f}" r="7" fill="#fb923c"/>'
    '</svg>'
)
(output_root / "overview.svg").write_text(svg, encoding="utf-8")
PY

chmod -R a-w "$OUTPUT_STAGING"
mv "$OUTPUT_STAGING" "$OUTPUT_ROOT"
progress 93 cloud_complete "云端 GLIM 产物已封存"
echo "GoGoGuard cloud GLIM job complete: $JOB_ID"
