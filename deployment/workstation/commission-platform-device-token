#!/usr/bin/env bash
set -euo pipefail

if [[ $(uname -s) != Darwin ]] || [[ ! -x /usr/bin/security ]]; then
  echo "platform device token commissioning requires macOS Keychain" >&2
  exit 2
fi

readonly KEYCHAIN_SERVICE=${GOGOGUARD_DEVICE_TOKEN_KEYCHAIN_SERVICE:-com.gogoguard.field-workstation.device-token}
readonly KEYCHAIN_ACCOUNT=${GOGOGUARD_DEVICE_TOKEN_KEYCHAIN_ACCOUNT:-$(id -un)}

echo "Enter the GoGoGuard platform device token at the secure Keychain prompt." >&2
/usr/bin/security add-generic-password \
  -U \
  -a "$KEYCHAIN_ACCOUNT" \
  -s "$KEYCHAIN_SERVICE" \
  -l "GoGoGuard Field Workstation Device Token" \
  -w

# Prove that the same account/service lookup returns a nonempty value without
# printing it or keeping it in the shell after the check.
stored_token=$(
  /usr/bin/security find-generic-password \
    -a "$KEYCHAIN_ACCOUNT" \
    -s "$KEYCHAIN_SERVICE" \
    -w
)
if [[ -z $stored_token ]]; then
  unset stored_token
  echo "macOS Keychain returned an empty platform device token" >&2
  exit 3
fi
unset stored_token
echo "GoGoGuard platform device token commissioned in macOS Keychain." >&2
